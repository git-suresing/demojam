apiVersion: v1
baseDomain: {{ Base_Domain }}
metadata:
  name: {{ Cluster_Name }}
networking:
  clusterNetwork:
{% if IP_Subnet_Type in ['ipv4', 'dual'] %}
  - cidr: {{ Cluster_Network_ipv4 }}
    hostPrefix: 23
{% endif %}
{% if IP_Subnet_Type in ['ipv6', 'dual'] %}
  - cidr: {{ Cluster_Network_ipv6 }}
    hostPrefix: 64
{% endif %}
  machineNetwork:
{% if IP_Subnet_Type in ['ipv4', 'dual'] %}
  - cidr: {{ Machine_Network_ipv4 }}/{{ Machine_Network_Subnet_ipv4 }}
{% endif %}
{% if IP_Subnet_Type in ['ipv6', 'dual'] %}
  - cidr: {{ Machine_Network_ipv6 }}/{{ Machine_Network_Subnet_ipv6 }}
{% endif %}
  networkType: OVNKubernetes
  serviceNetwork:
{% if IP_Subnet_Type in ['ipv4', 'dual'] %}
  - {{ Service_Network_ipv4 }}
{% endif %}
{% if IP_Subnet_Type in ['ipv6', 'dual'] %}
  - {{ Service_Network_ipv6 }}
{% endif %}
compute:
- name: worker
  replicas: {{ Worker_Count }}
controlPlane:
  name: master
  replicas: 3
  platform:
    baremetal: {}
platform:
  baremetal:
{% if IP_Subnet_Type in ['ipv4', 'dual'] %}
    apiVIP: {{ api_vip_ipv4 }}
    ingressVIP: {{ ingress_vip_ipv4 }}
{% elif IP_Subnet_Type == 'ipv6' %}
    apiVIP: {{ api_vip_ipv6 }}
    ingressVIP: {{ ingress_vip_ipv6 }}
{% endif %}
    provisioningNetwork: "Disabled"
    bootstrapExternalStaticIP: {{ bootstrapExternalStaticIP | default(DNS_IP.split(' ')[0], true) }}
    bootstrapExternalStaticGateway: {{ Machine_Network_Gateway_ipv4 }}
    bootstrapExternalStaticDNS: {{ DNS_IP.split(' ')[0] }}
    hosts:
{% for host in Hosts %}
      - name: {{ host.Host_Name }}
        role: {{ host.Role }}
        bmc:
{% if ILO_RedFish_API %}
{% set orig_ip = ILO_RedFish_API.split('://')[1].split('/')[0] %}
          address: {{ ILO_RedFish_API | replace(orig_ip, host.ILO_IP) }}
{% else %}
          address: redfish-virtualmedia://{{ host.ILO_IP }}/redfish/v1
{% endif %}
          username: {{ ILO_UserName | default('admin', true) }}
          password: {{ ILO_Password | default('admin', true) }}
          disableCertificateVerification: True
        bootMACAddress: {{ host['Bond-Interface1-mac'] | default(host.bootMACAddress, true) }}
        bootMode: {{ bootMode }}
        rootDeviceHints:
          {{ host.root_Device_Hints }}
        networkConfig:
          interfaces:
            - name: {{ Bond_Name | default('bond0', true) }}
              type: bond
              state: up
              mtu: {{ MTU }}
              ipv4:
                enabled: false
              ipv6:
                enabled: false
              lldp:
                enabled: false
{% if Bond_Type == 'Active-Passive' %}
              link-aggregation:
                mode: active-backup
                options:
                  miimon: "100"
{% else %}
              link-aggregation:
                mode: 802.3ad
                options:
                  miimon: "100"
                  lacp_rate: 1
                  xmit_hash_policy: "layer3+4"
{% endif %}
                port:
                  - {{ host.get('Bond_Interface-1_Name', 'enp98s0f0') }}
                  - {{ host.get('Bond_Interface-2_Name', 'enp161s0f0') }}
            - name: {{ Bond_Name | default('bond0', true) }}.{{ Machine_Network_Vlan | default('811', true) }}
              type: vlan
              state: up
              vlan:
                base-iface: {{ Bond_Name | default('bond0', true) }}
                id: {{ Machine_Network_Vlan | default('811', true) }}
{% if IP_Subnet_Type in ['ipv4', 'dual'] %}
              ipv4:
                enabled: true
                address:
                  - ip: {{ host.Machine_ipv4 }}
                    prefix-length: {{ Machine_Network_Subnet_ipv4 }}
                dhcp: false
{% else %}
              ipv4:
                enabled: false
{% endif %}
{% if IP_Subnet_Type in ['ipv6', 'dual'] %}
              ipv6:
                enabled: true
                address:
                  - ip: {{ host.Machine_ipv6 }}
                    prefix-length: {{ Machine_Network_Subnet_ipv6 }}
                dhcp: false
{% else %}
              ipv6:
                enabled: false
{% endif %}
          dns-resolver:
            config:
              search:
                - {{ Base_Domain }}
              server:
{% for dns in DNS_IP.split(' ') %}
                - {{ dns }}
{% endfor %}
              options:
                - 'no-aaaa'
          routes:
            config:
{% if IP_Subnet_Type in ['ipv4', 'dual'] %}
              - destination: 0.0.0.0/0
                next-hop-address: {{ Machine_Network_Gateway_ipv4 }}
                next-hop-interface: {{ Bond_Name | default('bond0', true) }}.{{ Machine_Network_Vlan | default('811', true) }}
{% endif %}
{% if IP_Subnet_Type in ['ipv6', 'dual'] %}
              - destination: ::/0
                next-hop-address: {{ Machine_Network_Gateway_ipv6 }}
                next-hop-interface: {{ Bond_Name | default('bond0', true) }}.{{ Machine_Network_Vlan | default('811', true) }}
{% endif %}
{% endfor %}

pullSecret: '{{ pullsecret }}'
sshKey: '{{ sshKey }}'
{% if mirror_registory_url and mirror_registory_url.strip() %}
imageContentSources:
- mirrors:
  - {{ mirror_registory_url }}/openshift/release
  source: quay.io/openshift-release-dev/ocp-v4.0-art-dev
- mirrors:
  - {{ mirror_registory_url }}/openshift/release-images
  source: quay.io/openshift-release-dev/ocp-release
{% endif %}
{% if External_Quay_Certificate and External_Quay_Certificate.strip() %}
additionalTrustBundle: |
{{ External_Quay_Certificate | indent(2, True) }}
{% endif %}